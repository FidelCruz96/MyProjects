<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_audit_log_form" model="ir.ui.view">
        <field name="name">audit.log.form</field>
        <field name="model">audit.log</field>
        <field name="arch" type="xml">
            <form string="Log de Auditoría">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user"/>
                        <field name="action_type"/>
                        <field name="status"/>
                        <field name="timestamp"/>
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_audit_log_tree" model="ir.ui.view">
        <field name="name">audit.log.tree</field>
        <field name="model">audit.log</field>
        <field name="arch" type="xml">
            <tree string="Logs de Auditoría">
                <field name="name"/>
                <field name="user"/>
                <field name="action_type"/>
                <field name="status"/>
                <field name="timestamp"/>
            </tree>
        </field>
    </record>

    <record id="action_audit_log" model="ir.actions.act_window">
        <field name="name">Registros de Auditoría</field>
        <field name="res_model">audit.log</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_audit_log_root" name="Auditoría" parent="base.menu_administration"/>
    <menuitem id="menu_audit_log" name="Registros de Auditoría" parent="menu_audit_log_root" action="action_audit_log"/>
</odoo>
