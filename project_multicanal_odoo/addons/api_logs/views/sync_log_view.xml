<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sync_log_form" model="ir.ui.view">
        <field name="name">sync.log.form</field>
        <field name="model">sync.log</field>
        <field name="arch" type="xml">
            <form string="Log de Sincronización">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="channel_id"/>
                        <field name="order_id"/>
                        <field name="status"/>
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sync_log_tree" model="ir.ui.view">
        <field name="name">sync.log.tree</field>
        <field name="model">sync.log</field>
        <field name="arch" type="xml">
            <tree string="Logs">
                <field name="name"/>
                <field name="channel_id"/>
                <field name="order_id"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="action_sync_log" model="ir.actions.act_window">
        <field name="name">Logs de Sincronización</field>
        <field name="res_model">sync.log</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_sync_log_root" name="Sincronizacion" parent="sale.menu_sale_config"/>
    <menuitem id="menu_sync_log" name="Logs de Sincronización" parent="menu_sync_log_root" action="action_sync_log"/>
</odoo>
